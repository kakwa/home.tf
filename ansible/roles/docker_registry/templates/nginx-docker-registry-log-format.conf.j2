# Managed by Ansible — log_format must live in http context (included via conf.d)
log_format docker_registry_detailed '$remote_addr - $remote_user [$time_local] '
  '"$request" $status $body_bytes_sent '
  'upstream_status=$upstream_status upstream_addr=$upstream_addr '
  'upstream_connect_time=$upstream_connect_time upstream_header_time=$upstream_header_time upstream_response_time=$upstream_response_time '
  'request_time=$request_time '
  '"$http_referer" "$http_user_agent"';
