# Managed by Ansible (roles/llama-server). Changes may be overwritten.
# Profile: {{ llama_server_profile_label }} {{ llama_server_quant }}, ctx={{ llama_server_ctx_size }}, kv={{ llama_server_kv_type }},
# MTP={{ 'on' if llama_server_mtp | bool else 'off' }}, backend={{ llama_server_backend }} — tuned for a 20 GiB AMD GPU.

LLAMA_ARG_MODEL={{ llama_server_model_dir }}/{{ llama_server_quants[llama_server_quant].file }}
{% if llama_server_vision | bool %}
LLAMA_ARG_MMPROJ={{ llama_server_model_dir }}/{{ llama_server_mmproj.file }}
{% endif %}
LLAMA_ARG_CTX_SIZE={{ llama_server_ctx_size }}
LLAMA_ARG_N_GPU_LAYERS={{ llama_server_n_gpu_layers }}
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_TYPE_K={{ llama_server_kv_type }}
LLAMA_ARG_CACHE_TYPE_V={{ llama_server_kv_type }}
LLAMA_ARG_N_PARALLEL={{ llama_server_n_parallel }}
LLAMA_ARG_BATCH={{ llama_server_batch_size }}
LLAMA_ARG_UBATCH={{ llama_server_ubatch_size }}
LLAMA_ARG_JINJA=1
LLAMA_ARG_ALIAS={{ llama_server_alias }}
LLAMA_ARG_HOST={{ llama_server_listen_host }}
LLAMA_ARG_PORT={{ llama_server_listen_port }}
LLAMA_ARG_DEVICE={{ llama_server_backend_device }}
{% if llama_server_mtp | bool %}
LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_N_MAX={{ llama_server_spec_n_max }}
LLAMA_ARG_SPEC_DRAFT_N_MIN=0
{% endif %}
LLAMA_ARG_ENDPOINT_METRICS={{ '1' if llama_server_endpoint_metrics | bool else '0' }}
LLAMA_ARG_THREADS={{ llama_server_threads }}
{% if llama_server_api_key | default('') | length > 0 %}
LLAMA_ARG_API_KEY={{ llama_server_api_key }}
{% endif %}
# API key is enforced by nginx, not by llama.cpp (see llama-server.nginx.conf).
