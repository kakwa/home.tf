#!/usr/bin/env python3
# Generated by Ansible (ai-power role) - do not edit.
"""ai-power-monitor: put the host to sleep when llama-server goes idle.

Polls llama-server's Prometheus /metrics endpoint (localhost only).
Activity is movement of the monotonic llamacpp:tokens_predicted_total
counter, or any in-flight request (llamacpp:requests_processing /
llamacpp:requests_deferred > 0). When neither happens for IDLE_TIMEOUT
seconds, the host is put to sleep.

Sleep modes:
  Raw /sys/power/state values ("standby", "mem", "disk", "freeze") are
  written directly to /sys/power/state. "standby" (S1) puts only the CPU
  to idle, leaving peripherals fully powered, so Wake-on-LAN works without
  any firmware help.
  systemd-level modes ("suspend", "hibernate", etc.) are issued via
  "systemctl <mode>".

The activity baseline (last-seen counter value + last-activity timestamp)
is persisted to STATE_FILE so the idle clock survives service restarts.
A counter value lower than the saved one means llama-server restarted
(zeroed counters, e.g. after wake from sleep); the clock restarts
from now in that case.

By default llama-server is stopped before sleeping and restarted after
wake (STOP_LLAMA_ON_SLEEP), so the GPU's pinned model buffers are released
and suspend/resume is fast. The monitor polls the unit until it is fully
inactive and its cgroup is empty before writing to /sys/power/state; if it
cannot confirm a complete shutdown (escalating to SIGKILL after
LLAMA_STOP_TIMEOUT) it refuses to sleep.

Run with --now to perform one immediate sleep cycle (stop llama-server,
sleep, wake, restart llama-server) and exit, ignoring the idle timeout.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

METRICS_URL = "{{ ai_power_metrics_url }}"
IDLE_TIMEOUT = {{ ai_power_idle_timeout }}
POLL_INTERVAL = {{ ai_power_poll_interval }}
STATUS_LOG_INTERVAL = {{ ai_power_status_log_interval }}
SLEEP_MODE = "{{ ai_power_sleep_mode }}"
STATE_FILE = "{{ ai_power_state_dir }}/state.json"

# Stop llama-server before sleeping and restart it after wake. Freeing the
# GPU's pinned model buffers makes suspend/resume fast and avoids the
# amdgpu/KFD resume OOM seen when the model is loaded (see report.md).
STOP_LLAMA_ON_SLEEP = {{ ai_power_stop_llama_on_sleep }}
LLAMA_SERVICE = "{{ ai_power_llama_service }}"

# How long to wait for `systemctl stop` to finish (the model unload / GPU
# flush can take a while), how often to re-check, and how long to wait after
# escalating to SIGKILL if the service still is not gone.
LLAMA_STOP_TIMEOUT = {{ ai_power_llama_stop_timeout }}
LLAMA_STOP_POLL_INTERVAL = {{ ai_power_llama_stop_poll_interval }}
LLAMA_STOP_KILL_GRACE = {{ ai_power_llama_stop_kill_grace }}

# Unit cgroup locations: cgroup v2, hybrid unified hierarchy, and the legacy
# v1 systemd hierarchy.
CGROUP_ROOTS = (
    "/sys/fs/cgroup",
    "/sys/fs/cgroup/unified",
    "/sys/fs/cgroup/systemd",
)

# Single monotonic activity counter. tokens_predicted_total only ever
# increases within a llama-server run (reset on restart), so a drop
# unambiguously signals a restart.
COUNTER = "llamacpp:tokens_predicted_total"

# In-flight request gauges; non-zero means do not sleep.
INFLIGHT = ("llamacpp:requests_processing", "llamacpp:requests_deferred")

METRIC_RE = re.compile(r"^llamacpp:([a-zA-Z_0-9]+)\s+(-?[\d.eE+]+)\s*$")


def log(msg):
    print(time.strftime("%Y-%m-%dT%H:%M:%S"), msg, flush=True)


def boot_time():
    try:
        with open("/proc/stat") as f:
            for line in f:
                if line.startswith("btime "):
                    return int(line.split()[1])
    except OSError:
        pass
    return 0


def fetch_metrics():
    try:
        with urllib.request.urlopen(METRICS_URL, timeout=5) as resp:
            return resp.read().decode("utf-8", "replace")
    except Exception as exc:
        log("metrics fetch failed: %s" % exc)
        return None


def parse_metrics(text):
    counter = None
    inflight = 0
    for line in text.splitlines():
        m = METRIC_RE.match(line)
        if not m:
            continue
        name, value = m.group(1), float(m.group(2))
        if name == "tokens_predicted_total":
            counter = value
        elif name in ("requests_processing", "requests_deferred"):
            inflight = max(inflight, value)
    return counter, inflight


def load_state():
    now = time.time()
    try:
        with open(STATE_FILE) as f:
            raw = json.load(f)
        last_activity = max(float(raw.get("last_activity", 0)), boot_time())
        return {"last_activity": last_activity, "counter": raw.get("counter")}
    except (OSError, ValueError, TypeError):
        return {"last_activity": now, "counter": None}


def save_state(state):
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
        f.write("\n")
    os.replace(tmp, STATE_FILE)


# Raw /sys/power/state values that can be written directly, bypassing
# systemd-sleep entirely.
RAW_STATES = ("freeze", "standby", "mem", "disk")


def sleep_host():
    """Put the host to sleep. Return True if the call completed."""
    if SLEEP_MODE in RAW_STATES:
        log("sleeping (%s via /sys/power/state)" % SLEEP_MODE)
        try:
            with open("/sys/power/state", "w") as f:
                f.write(SLEEP_MODE)
        except Exception as exc:
            log("/sys/power/state write '%s' failed: %s" % (SLEEP_MODE, exc))
            return False
    else:
        log("sleeping (systemctl %s)" % SLEEP_MODE)
        try:
            subprocess.run(["systemctl", SLEEP_MODE], check=True)
        except Exception as exc:
            log("systemctl %s failed: %s" % (SLEEP_MODE, exc))
            return False
    return True


def systemctl(service, verb):
    """Best-effort `systemctl <verb> <service>`. Returns True on success."""
    try:
        subprocess.run(
            ["systemctl", verb, service],
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        log(
            "systemctl %s %s failed (rc=%s): %s"
            % (verb, service, exc.returncode, detail or exc)
        )
        return False
    except Exception as exc:
        log("systemctl %s %s failed: %s" % (verb, service, exc))
        return False
    log("systemctl %s %s" % (verb, service))
    return True


# Handle for the in-flight fire-and-forget `systemctl stop` so the main loop
# can reap it once it finishes without blocking.
_stop_proc = None


def start_llama_stop():
    """Ask llama-server to stop without blocking the caller.

    `systemctl stop` blocks until the unit is fully stopped, which can take a
    while (model unload / GPU flush on shutdown). We launch it and return
    immediately, then poll its progress with wait_llama_stopped()."""
    global _stop_proc
    try:
        _stop_proc = subprocess.Popen(
            ["systemctl", "stop", LLAMA_SERVICE],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as exc:
        log("systemctl stop %s failed to launch: %s" % (LLAMA_SERVICE, exc))
        _stop_proc = None
    log("systemctl stop %s (fire-and-forget)" % LLAMA_SERVICE)


def reap_llama_stop():
    """Reap the fire-and-forget stop process if it has already finished.

    Non-blocking: only collects the child once it has exited, so it never
    delays polling. Called once per loop iteration to avoid a zombie
    accumulating on every sleep cycle."""
    global _stop_proc
    if _stop_proc is not None and _stop_proc.poll() is not None:
        _stop_proc = None


def systemctl_show(properties):
    """Return selected `systemctl show` properties as a dict, or None."""
    try:
        result = subprocess.run(
            ["systemctl", "show"]
            + ["--property=" + prop for prop in properties]
            + [LLAMA_SERVICE],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as exc:
        log("systemctl show %s failed: %s" % (LLAMA_SERVICE, exc))
        return None
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        log(
            "systemctl show %s failed (rc=%s): %s"
            % (LLAMA_SERVICE, result.returncode, detail or result)
        )
        return None
    props = {}
    for line in result.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            props[key] = value
    return props


def cgroup_pids(control_group):
    """PIDs still in a unit's cgroup, including descendant cgroups.

    Returns an empty set when the cgroup no longer exists (systemd removes
    it once the unit is fully stopped), or None if it cannot be read.
    """
    if not control_group:
        return set()
    base = None
    for root in CGROUP_ROOTS:
        candidate = root + control_group
        if os.path.isdir(candidate):
            base = candidate
            break
    if base is None:
        return set()
    pids = set()
    for dirpath, _dirnames, _filenames in os.walk(base):
        procs = os.path.join(dirpath, "cgroup.procs")
        try:
            with open(procs) as f:
                pids.update(int(pid) for pid in f.read().split())
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as exc:
            log("cannot read %s: %s" % (procs, exc))
            return None
    return pids


def llama_down_state():
    """Return (fully_stopped, detail) for the llama-server unit.

    Fully stopped means the unit is inactive/failed *and* no process remains
    in its cgroup (including descendants). A unit that is still deactivating,
    or that is marked inactive but left processes behind, is not down."""
    props = systemctl_show(("ActiveState", "SubState", "ControlGroup"))
    if props is None:
        return False, "unknown (systemctl show failed)"
    active = props.get("ActiveState") or "unknown"
    sub = props.get("SubState") or "unknown"
    if active not in ("inactive", "failed"):
        return False, "%s/%s" % (active, sub)
    pids = cgroup_pids(props.get("ControlGroup", ""))
    if pids is None:
        return False, "%s/%s (cgroup unreadable)" % (active, sub)
    if pids:
        return False, "%s/%s (%d process(es) left: %s)" % (
            active,
            sub,
            len(pids),
            ",".join(str(pid) for pid in sorted(pids)),
        )
    return True, "%s/%s" % (active, sub)


def wait_for_llama_down(timeout):
    """Poll until llama-server is fully down or `timeout` seconds elapse."""
    deadline = time.monotonic() + timeout
    last_detail = None
    while True:
        reap_llama_stop()
        down, detail = llama_down_state()
        if down:
            log("%s is fully stopped (%s)" % (LLAMA_SERVICE, detail))
            return True
        if detail != last_detail:
            log("waiting for %s to stop: %s" % (LLAMA_SERVICE, detail))
            last_detail = detail
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(LLAMA_STOP_POLL_INTERVAL, remaining))


def wait_llama_stopped():
    """Wait until llama-server is completely stopped.

    The fire-and-forget `systemctl stop` can take a while to unload the model
    and flush the GPU, so poll until the unit is inactive/failed with an empty
    cgroup. If that takes longer than LLAMA_STOP_TIMEOUT, SIGKILL every
    remaining process and give the stop job LLAMA_STOP_KILL_GRACE more
    seconds. Returns True only once the unit is confirmed gone.
    """
    if wait_for_llama_down(LLAMA_STOP_TIMEOUT):
        return True
    log(
        "%s did not stop within %ss: sending SIGKILL to all processes"
        % (LLAMA_SERVICE, LLAMA_STOP_TIMEOUT)
    )
    try:
        result = subprocess.run(
            [
                "systemctl",
                "kill",
                "--kill-who=all",
                "--signal=SIGKILL",
                LLAMA_SERVICE,
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "").strip()
            log(
                "systemctl kill %s failed (rc=%s): %s"
                % (LLAMA_SERVICE, result.returncode, detail or result)
            )
    except Exception as exc:
        log("systemctl kill %s failed: %s" % (LLAMA_SERVICE, exc))
    if wait_for_llama_down(LLAMA_STOP_KILL_GRACE):
        return True
    _down, detail = llama_down_state()
    log("%s is still not fully stopped (%s)" % (LLAMA_SERVICE, detail))
    return False


def sleep_cycle():
    """One full sleep cycle: ask llama-server to stop, wait until it is
    completely down (if configured), put the host to sleep, then restart
    llama-server after wake.

    Returns True if the sleep call itself completed. llama-server is always
    restarted after the attempt, even if the sleep failed, so the host is left
    in its previous state. If a complete shutdown cannot be confirmed, the
    host is *not* put to sleep, to avoid suspending with the model still in
    GPU memory."""
    if STOP_LLAMA_ON_SLEEP:
        start_llama_stop()
        if not wait_llama_stopped():
            log("not sleeping: %s could not be stopped completely" % LLAMA_SERVICE)
            systemctl(LLAMA_SERVICE, "start")
            return False
    ok = sleep_host()
    if STOP_LLAMA_ON_SLEEP:
        systemctl(LLAMA_SERVICE, "start")
    return ok


def log_status(state, inflight, idle, remaining):
    """Log a periodic dump of the idle-monitor state and sleep countdown."""
    log(
        "state: last_activity=%s idle=%ds sleep_in=%ds sleep_at=%s "
        "counter=%r inflight=%s"
        % (
            time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(state["last_activity"])),
            int(idle),
            int(remaining),
            time.strftime(
                "%Y-%m-%dT%H:%M:%S",
                time.localtime(state["last_activity"] + IDLE_TIMEOUT),
            ),
            state["counter"],
            inflight,
        )
    )


def main():
    state = load_state()
    log(
        "starting: idle_timeout=%ss poll=%ss status_log=%ss sleep_mode=%s baseline=%s counter=%r"
        % (
            IDLE_TIMEOUT,
            POLL_INTERVAL,
            STATUS_LOG_INTERVAL,
            SLEEP_MODE,
            time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(state["last_activity"])),
            state["counter"],
        )
    )
    last_status_log = 0.0
    while True:
        now = time.time()
        # Reap a finished fire-and-forget stop (non-blocking).
        reap_llama_stop()
        # Adopt a fresher baseline written by another instance (e.g. a manual
        # `--now` run) so we don't immediately re-trigger a sleep right after
        # it woke the host. Only the most recent activity is ever kept.
        disk = load_state()
        if disk["last_activity"] > state["last_activity"]:
            state["last_activity"] = disk["last_activity"]
        inflight = None
        text = fetch_metrics()
        if text is not None:
            counter, inflight = parse_metrics(text)
            if counter is not None:
                if state["counter"] is not None and counter < state["counter"]:
                    log(
                        "counter reset (llama-server restarted): %r -> %r"
                        % (state["counter"], counter)
                    )
                if state["counter"] is None or counter != state["counter"]:
                    state["last_activity"] = now
                    state["counter"] = counter
                    save_state(state)
            if inflight:
                state["last_activity"] = now
                save_state(state)

        idle = max(0.0, now - state["last_activity"])
        remaining = max(0.0, IDLE_TIMEOUT - idle)
        status_due = now - last_status_log >= STATUS_LOG_INTERVAL
        if status_due:
            log_status(state, inflight, idle, remaining)
            last_status_log = now

        if idle >= IDLE_TIMEOUT:
            log("idle timeout reached (idle=%ds): starting %s" % (int(idle), SLEEP_MODE))
            if sleep_cycle():
                log("resumed from %s" % SLEEP_MODE)
            # Reset the idle clock whether or not sleep succeeded: after a
            # resume we must not sleep again immediately, and after a
            # failed attempt we should not retry on every poll.
            state["last_activity"] = time.time()
            save_state(state)
            last_status_log = 0.0
            # Skip the trailing sleep so the first post-resume poll and status
            # log happen immediately instead of waiting a full POLL_INTERVAL.
            continue
        time.sleep(POLL_INTERVAL)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="ai-power-monitor",
        description="Put the host to sleep when llama-server goes idle.",
    )
    parser.add_argument(
        "--now",
        action="store_true",
        help="sleep immediately (one-shot) and exit, ignoring the idle timeout",
    )
    return parser.parse_args(argv)


def run_now():
    """Perform a single immediate sleep cycle and record a fresh baseline so a
    concurrently running daemon does not re-trigger a sleep right after."""
    log("manual --now: starting immediate %s" % SLEEP_MODE)
    ok = sleep_cycle()
    if ok:
        log("manual --now: resumed from %s" % SLEEP_MODE)
    else:
        log("manual --now: %s did not complete" % SLEEP_MODE)
    state = load_state()
    state["last_activity"] = time.time()
    state["counter"] = None
    save_state(state)
    return 0 if ok else 1


if __name__ == "__main__":
    args = parse_args(sys.argv[1:])
    try:
        if args.now:
            sys.exit(run_now())
        main()
    except KeyboardInterrupt:
        sys.exit(0)
