# Generated by Ansible (ai-power role) - do not edit.
#
# Restrict suspend to suspend-to-RAM and pin the memory sleep mode.
#
# SuspendState=mem keeps systemd from trying "standby" and "freeze" first.
# MemorySleepMode picks the kernel mode written to /sys/power/mem_sleep:
# without it the kernel uses its default (the deepest supported mode, i.e.
# "deep"/S3 on this host), which takes minutes to enter and resume here.
[Sleep]
SuspendState=mem
{% if ai_power_mem_sleep | length > 0 %}
MemorySleepMode={{ ai_power_mem_sleep }}
{% endif %}
