# Ansible inventory generated by OpenTofu (tofu/infra/inventory.yml.tpl).
# Do not edit by hand: it is overwritten on every `tofu apply`.

all:
  children:
    dns:
      hosts:
        ${dns_vm.name}:
          ansible_host: ${dns_vm.ip}

    ldap:
      hosts:
        ${ldap_vm.name}:
          ansible_host: ${ldap_vm.ip}

    ansible_master:
      hosts:
        ${ansible_master_vm.name}:
          ansible_host: ${ansible_master_vm.ip}

  vars:
    ansible_user: ${vm_admin_user}
