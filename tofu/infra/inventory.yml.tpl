# Ansible inventory generated by OpenTofu (tofu/infra/inventory.yml.tpl)
# into ansible/inventory/infra.yml.
# Do not edit by hand: it is overwritten on every `tofu apply`.

all:
  children:
    # Group names are prefixed with the pool name so they never collide with
    # a host name (Ansible warns on group/host name collisions).
    infra_dns:
      hosts:
        ${dns_vm.name}:
          ansible_host: ${dns_vm.ip}

    infra_ldap:
      hosts:
        ${ldap_vm.name}:
          ansible_host: ${ldap_vm.ip}

    infra_ansible_master:
      hosts:
        ${ansible_master_vm.name}:
          ansible_host: ${ansible_master_vm.ip}

    infra_registry:
      hosts:
        ${registry_vm.name}:
          ansible_host: ${registry_vm.ip}

  vars:
    ansible_user: ${vm_admin_user}
