          "attributes": {
            "content": "# Ansible inventory generated by OpenTofu (tofu/infra/inventory.yml.tpl)\n# into ansible/inventory/infra.yml.\n# Do not edit by hand: it is overwritten on every `tofu apply`.\n\nall:\n  children:\n    # Group names are prefixed with the pool name so they never collide with\n    # a host name (Ansible warns on group/host name collisions).\n    infra_dns:\n      hosts:\n        dns:\n          ansible_host: 192.168.1.25\n\n    infra_ldap:\n      hosts:\n        ldap:\n          ansible_host: 192.168.1.15\n\n    infra_ansible_master:\n      hosts:\n        ansible-master:\n          ansible_host: 192.168.1.35\n\n    infra_registry:\n      hosts:\n        registry:\n          ansible_host: 192.168.1.36\n\n  vars:\n    ansible_user: kakwa\n",
